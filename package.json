{
  "name": "dkn-nexus",
  "version": "1.6.22",
  "private": true,
  "description": "DKN Nexus — a quiet, fast Windows desktop hub.",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc && vite build --configLoader runner",
    "test:media": "node --experimental-strip-types tests/run-contract-tests.mjs",
    "check:bundle": "npm run build && node tests/check-bundle.mjs",
    "verify:release": "powershell.exe -NoProfile -File scripts/verify-windows-release.ps1 -ExecutablePath src-tauri/target/release/dkn-nexus.exe",
    "release:desktop": "tauri build --no-bundle && powershell.exe -NoProfile -File scripts/verify-windows-release.ps1 -ExecutablePath src-tauri/target/release/dkn-nexus.exe -NormalizeIntegrity",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
