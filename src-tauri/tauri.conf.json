{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DKN Nexus",
  "version": "1.6.22",
  "identifier": "com.dkn.nexus",
  "build": {
    "beforeDevCommand": ".\\node_modules\\.bin\\vite.cmd --configLoader runner",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": ".\\node_modules\\.bin\\tsc.cmd && .\\node_modules\\.bin\\vite.cmd build --configLoader runner",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DKN Nexus",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": true,
        "center": true,
        "skipTaskbar": true
      },
      {
        "label": "radial",
        "title": "DKN Nexus Radial",
        "url": "index.html?window=radial",
        "width": 760,
        "height": 520,
        "minWidth": 760,
        "minHeight": 520,
        "maxWidth": 760,
        "maxHeight": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "agent",
        "title": "DKN Nexus · Agent",
        "url": "index.html?window=agent&panel=workspace",
        "width": 1600,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      },
      {
        "label": "music",
        "title": "DKN Nexus · 音乐播放器",
        "url": "index.html?window=music",
        "width": 360,
        "height": 540,
        "minWidth": 340,
        "minHeight": 500,
        "maxWidth": 460,
        "maxHeight": 760,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "DKN Nexus"
      }
    }
  }
}
